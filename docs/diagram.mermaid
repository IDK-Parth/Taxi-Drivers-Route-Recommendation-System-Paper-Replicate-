flowchart TD

subgraph group_data["Research data"]
  node_events["Search and pickup events"]
  node_earnings["Pickup earnings"]
  node_trajectories["Taxi trajectories"]
  node_model_inputs["Sample model inputs"]
  node_weather["Weather data<br/>[weather.csv]"]
  node_road_network["Road network"]
  node_adjacency["Segment adjacency"]
end

subgraph group_prediction["Pickup prediction"]
  node_feature_prep["Feature preparation<br/>[gcn_lstm_split.py]"]
  node_gcn["Spatial graph convolution<br/>[gcn_lstm_split.py]"]
  node_lstm["Temporal modeling<br/>[gcn_lstm_split.py]"]
  node_model_training["Model training<br/>[gcn_lstm_split.py]"]
end

subgraph group_routing["Route optimization"]
  node_segment_properties["Predicted road properties"]
  node_route_search["Sequential route search"]
end

subgraph group_results["Recommendations"]
  node_route_result["Suggested route<br/>[query_response.csv]"]
  node_model_summary["Model summary"]
end

node_driver(("Taxi driver"))

node_model_inputs -->|"loads features"| node_feature_prep
node_weather -->|"loads weather"| node_feature_prep
node_adjacency -->|"loads adjacency"| node_feature_prep
node_feature_prep -->|"prepares inputs"| node_gcn
node_gcn -->|"feeds spatial features"| node_lstm
node_lstm -->|"produces predictions"| node_model_training
node_model_training -->|"records summary"| node_model_summary
node_driver -->|"requests route"| node_route_search
node_road_network -->|"loads network"| node_route_search
node_segment_properties -->|"loads properties"| node_route_search
node_route_search -->|"writes recommendation"| node_route_result
node_route_search -->|"returns route"| node_driver

